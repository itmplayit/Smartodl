{
  "name": "smartodl-server",
  "version": "1.0.0",
  "private": true,
  "description": "SmartODL production API",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "env:check": "node config/validate-env.js",
