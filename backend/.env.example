# SmartODL API — production template
# Copy this file to .env on the server. Never commit the resulting .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=5000
CLIENT_URL=
TRUST_PROXY=1

# Dedicated, least-privilege application database account
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smartodl_app
DB_PASSWORD=
DB_NAME=education_platform
DB_CONNECTION_LIMIT=10
# Enable TLS for a remote database. Local Unix/VPS connections may leave this false.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=
DB_SSL_SERVERNAME=

# Generate each secret independently, for example:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Lesson video / PDF uploads.
# Files are stored under UPLOAD_DIR/lesson-media and are NEVER served as static
# files: playback goes through /api/lessons/:id/video|pdf, which checks
# enrolment on every request.
MAX_VIDEO_SIZE_MB=200
MAX_PDF_SIZE_MB=25
# Lifetime of the short-lived playback ticket the lesson page requests.
MEDIA_TICKET_TTL_SECONDS=300
# Optional dedicated signing secret; falls back to JWT_ACCESS_SECRET.
MEDIA_TOKEN_SECRET=

# local = isolated judge worker; judge0 = managed/private Judge0 service
JUDGE_MODE=local
JUDGE_SERVICE_URL=http://127.0.0.1:2358
JUDGE_SERVICE_TOKEN=
JUDGE0_URL=
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=

# OAuth is optional. Leave all fields blank to disable a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# On hosts with ephemeral disks (containers/PaaS), set this to the absolute
# path of a mounted volume (for example /data/uploads); otherwise every redeploy deletes all
# uploaded files (notes, avatars, and banners).
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# smtp enables password-reset email; disabled suppresses reset-token creation.
MAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS_REJECT_UNAUTHORIZED=true
MAIL_FROM=

# When MAIL_MODE=disabled, the reset link is not emailed; it is always printed in the server
# console log. The flag below also sends that link in the HTTP response, allowing the password
# to be reset directly from the browser.
# SET THIS TO 'true' ONLY WHEN THE SERVER IS NOT REACHABLE BY ANYONE ELSE.
# If this is enabled while the app is exposed through a tunnel, public IP, or LAN, anyone can request
# the owner's reset token without logging in and take over the account.
DEV_SHOW_RESET_LINK=false
SMTP_REQUIRE_TLS=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000

# Optional admin AI content generator. Leave API key blank to keep it unavailable.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

HINT_COST_POINTS=5

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000
AUTH_RATE_LIMIT_MAX=30
EXECUTION_RATE_LIMIT_MAX=60
SUBMIT_RATE_LIMIT_MAX=20
WRITE_RATE_LIMIT_MAX=180
RATE_LIMIT_DISABLED=false

# Optional: shared state for running MORE THAN ONE API instance. Leave blank
# for a single server (the normal setup). When set, rate limiting and the SSE
# event hub go through Redis so replicas share budgets/audiences. Note the
# live-proctor frame relay remains per-instance — use sticky sessions for
# proctoring, or a single API instance, during live exams.
REDIS_URL=

# ---- Live proctoring WebRTC (optional TURN relay) ----
# Only needed when students/hosts sit behind restrictive NATs and direct
# peer-to-peer media cannot connect. PROCTOR_TURN_SECRET is the coturn
# `static-auth-secret`; the API mints per-user credentials that expire
# after PROCTOR_TURN_TTL_SECONDS, so no reusable TURN password ever
# reaches a browser. Leave blank for STUN-only (the default).
PROCTOR_TURN_URLS=
PROCTOR_TURN_SECRET=
PROCTOR_TURN_TTL_SECONDS=600

# ---- Payments ----
# Three gateways are supported: RAZORPAY, PAYTM BUSINESS, and UPI DIRECT.
# Their keys do NOT belong in .env; they are configured under Admin -> Website Settings -> Payments
# and stored in the database so they can be changed without restarting the server. Any number may be
# enabled together; the student chooses one at checkout.
#
#
# Razorpay setup:
#   1. https://dashboard.razorpay.com -> Settings -> API Keys -> Generate key
#      (In TEST mode you receive rzp_test_... keys and no real money is charged)
#   2. Enter the Key ID and Key Secret under Admin -> Website Settings -> Payments
#      and turn on "Accept Razorpay".
#   NOTE: The RAZORPAY_* environment variables below are fallbacks only for OLD installations;
#   values saved in settings override them. Leave them blank in a new setup.
#
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (also configurable under Website Settings -> Payments). In the
# Razorpay dashboard add a webhook for <PUBLIC_URL>/api/subscriptions/razorpay/webhook
# (events: payment.captured, order.paid) with this secret — it activates orders
# even when the student closes the browser right after paying.
RAZORPAY_WEBHOOK_SECRET=
#
# Paytm Business setup:
#   1. https://business.paytm.com -> sign up -> Developer Settings -> API Keys
#   2. For testing: test MID + Merchant Key, WEBSITE = WEBSTAGING, env = test
#      For production: production MID + Merchant Key, WEBSITE = DEFAULT, env = live
#   3. Allow-list this callback URL in the Paytm dashboard:
#        <PUBLIC_URL>/api/subscriptions/paytm/callback
#   4. Enter the values under Admin -> Website Settings -> Payments and turn on "Accept Paytm".
# If nothing is configured, DEMO MODE is used outside production (payments are simulated and activated immediately).
#
# PUBLIC_URL: the URL through which Paytm can reach your server. If you use a tunnel
# (Cloudflare/ngrok), enter that URL here; otherwise the callback goes to localhost
# and the payment will not be confirmed.
PUBLIC_URL=

# ---- Runtime schema upgrades / demo payments safety ----
# Feature switches (including proctor_recording_enabled and integrity_score_*)
# are rows in the database `settings` table, NOT environment variables.
# Keep this blank for local installs so startup applies idempotent migrations.
# If you set SMARTODL_SKIP_MIGRATIONS=1, run `npm run migrate` first with a DB
# account allowed to insert/update schema and settings rows; otherwise the API
# will now fail fast with the exact missing settings instead of serving a broken UI.
SMARTODL_SKIP_MIGRATIONS=
# During a fresh local installation, a missing database is auto-detected and the schema is imported
# only when this is '1' (the .env generated by Setup.bat already sets it to 1).
SMARTODL_ALLOW_DB_AUTOSETUP=
# Never set this to 'true' in production: without a gateway, payments are simulated
# and a paid plan or course is activated for free. This is for local development only.
ALLOW_DEMO_PAYMENTS=false
CERT_RATE_LIMIT_MAX=120


# ---------------------------------------------------------------------------
# CAPTCHA — optional bot protection on register / login / forgot-password.
# Off by default: the middleware is a no-op until CAPTCHA_ENABLED=true.
#
#   image     (default) self-hosted SVG challenge, no third party, no signup.
#             CAVEAT: challenges are held in process memory, so this provider
#             only works on a SINGLE backend instance. Use a hosted provider
#             if you run more than one instance behind a load balancer.
#   recaptcha | hcaptcha | turnstile — vendor widget; needs a site + secret key.
#             These send user interaction data to the vendor and require
#             outbound HTTPS, so they will not work on an offline install.
# ---------------------------------------------------------------------------
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=image
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
# Score floor for providers that return one (reCAPTCHA v3, Turnstile).
CAPTCHA_MIN_SCORE=0.5
